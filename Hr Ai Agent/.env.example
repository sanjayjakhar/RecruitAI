# Groq AI API Key (Get yours from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Gmail SMTP Settings for Automated Interview Invitations
# (Generate 16-character App Password at: https://myaccount.google.com/apppasswords)
GMAIL=your_email@gmail.com
APP_PASSWORD=your_16_character_app_password

# Google Calendar OAuth Files
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.pickle
